# Keep the local demo enabled until AWS OIDC and Vercel preview authentication are configured.
NEXT_PUBLIC_AI_TUTOR_MODE=demo

# Server-only Vercel Preview settings for the live Bedrock route.
AI_TUTOR_ENABLED=false
AWS_REGION=
AWS_ROLE_ARN=

# Keys from the selected Clerk application. The secret key stays server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required to enforce the live tutor allowance. Keep the token server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
